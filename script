                    or (definition and definition.Weapon) or (cosmetic and cosmetic.ItemName) or "IsUniversal"}
            customCosmeticsRuntime.LocalRewardEntries[entry] = {Kind = kind, Name = name}
            table.insert(out, entry)
        end
    end
    return out
end

