-- The locker's "Random" tile stores the RANDOM_COSMETIC marker so the game keeps
-- showing Random plus its "Only Use Favorites" option. The concrete cosmetic is
-- rolled on this client, because the server would roll from the real inventory.
local randomRollCache = {}
local function rollRandomCosmeticName(ctype, weapon, favsOnly)
    -- With the spoof off the client must only offer cosmetics the account really
    -- owns, otherwise Random would pick something the server cannot render.
    local ownedOnly = not unlockAllEnabled
    local ownedSet = nil
    if ownedOnly then
        local ok, inv = pcall(function() return dctrl:Get("CosmeticInventory") end)
        ownedSet = (ok and type(inv) == "table") and inv or {}
    end
    local pool = {}
    local lowerWeapon = type(weapon) == "string" and weapon:lower() or nil
    for name, entry in pairs(coss) do
        if type(entry) == "table" and entry.Type == ctype and not banned(name) then
            local itemName = entry.ItemName or entry.WeaponName or entry.Weapon or entry.Item
            local matches
            if itemName then
                matches = lowerWeapon ~= nil and tostring(itemName):lower() == lowerWeapon
            else
                matches = ctype ~= "Skin"
            end
            local allowed = ownedSet == nil or ownedSet[name] ~= nil
            if allowed and matches and not (customCosmeticsRuntime and customCosmeticsRuntime.Locked[name]) then
                if not favsOnly or (favs[weapon] and favs[weapon][name]) then pool[#pool+1] = name end
            end
        end
    end
    if #pool == 0 then return nil end
    table.sort(pool)
    return pool[math.random(1, #pool)]
end

local function isRandomMarker(value)
    return type(value) == "table" and value.Name == "RANDOM_COSMETIC"
end

local function resolveMarkerValue(weapon, ctype, stored)
    if not isRandomMarker(stored) then return stored end
    local perWeapon = randomRollCache[weapon]
    if perWeapon and perWeapon[ctype] then return perWeapon[ctype] end
    local picked = rollRandomCosmeticName(ctype, weapon, stored.OnlyUseFavorites == true)
    if not picked then picked = rollRandomCosmeticName(ctype, weapon, false) end
    if not picked then return nil end
    local rolled = clonecos(picked, ctype)
    if not rolled then return nil end
    if stored.Inverted ~= nil then rolled.Inverted = stored.Inverted end
    if stored.OnlyUseFavorites ~= nil then rolled.OnlyUseFavorites = stored.OnlyUseFavorites end
    perWeapon = perWeapon or {}
    randomRollCache[weapon] = perWeapon
    perWeapon[ctype] = rolled
    return rolled
end

local function resolvedCosmeticCategory(weapon, ctype)
    local stored = equip[weapon] and equip[weapon][ctype]
    if isRandomMarker(stored) then return resolveMarkerValue(weapon, ctype, stored) end
    if stored ~= nil then return stored end
    -- The locker can also hold Random server-side (it accepts the marker itself).
    -- Render a concrete cosmetic for it while unlock-all is spoofing the catalog.
    if weapon then
        local reader = localWeaponDataRecords and localWeaponDataRecords.ReadOriginal
        local real = reader and reader(dctrl, weapon)
        local fallback = real and real[ctype]
        if isRandomMarker(fallback) then return resolveMarkerValue(weapon, ctype, fallback) end
    end
    return stored
end

-- Weapon data handed to the locker preview and the fight code still carries the
-- RANDOM_COSMETIC marker; swap in the rolled cosmetic so it can be rendered.
resolveWeaponDataMarkers = function(data, weapon)
    if type(data) ~= "table" then return data end
    for _, ctype in ipairs({"Skin", "Wrap", "Charm", "Finisher"}) do
        local value = data[ctype]
        if isRandomMarker(value) then
            local resolved = resolveMarkerValue(weapon, ctype, value)
            if resolved then
                if value.Inverted ~= nil then resolved.Inverted = value.Inverted end
                if value.OnlyUseFavorites ~= nil then resolved.OnlyUseFavorites = value.OnlyUseFavorites end
                data[ctype] = resolved
            end
        end
    end
    return data
end

local function resetRandomRolls(weapon)
    if weapon then randomRollCache[weapon] = nil else table.clear(randomRollCache) end
end

