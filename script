    local WeaponMods = (function()
        local Players = game:GetService("Players")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local LP = Players.LocalPlayer
        local Toggles = library.Toggles
        local Options = library.Options
        local WeaponMods = { Originals = {} }

        local function IsOn(id)

            local t = Toggles[id]

            return t ~= nil and t.Value == true

        end

        local function Num(id, default)

            local o = Options[id]

            if o and type(o.Value) == "number" then return o.Value end

            return default

        end

        local function FindModule(path)

            local node = LP:FindFirstChild("PlayerScripts")

            for _, name in ipairs(path) do

                if not node then return nil end

                node = node:FindFirstChild(name)

            end

            if not node then return nil end

            local ok, mod = pcall(require, node)

            if ok and type(mod) == "table" then return mod end

            return nil

        end

        local function GetLocalFighter()

            local controller = FindModule({ "Controllers", "FighterController" })

            return controller and rawget(controller, "LocalFighter") or nil

        end

        local function Patch(mod, key, makeWrapper)

            if not mod or type(mod[key]) ~= "function" then return end

            local store = WeaponMods.Originals

            store[mod] = store[mod] or {}

            if store[mod][key] then return end

            local orig = mod[key]

            store[mod][key] = orig

            mod[key] = makeWrapper(orig)

        end

        local function ScaleInfo(item, fields, factor)

            local info = item and item.Info

            if type(info) ~= "table" then return nil end

            local saved = {}

            for _, field in ipairs(fields) do

                if type(info[field]) == "number" then

                    saved[field] = info[field]

                    info[field] = math.max(0.001, info[field] * factor)

                end

            end

            return function()

                for field, value in pairs(saved) do info[field] = value end

            end

        end

        local function CallSafe(restore, orig, ...)

            local res = table.pack(pcall(orig, ...))

            if restore then restore() end

            if not res[1] then

                warn("[WeaponMods] " .. tostring(res[2]))

                return nil

            end

            return table.unpack(res, 2, res.n)

        end

        -- ---------- gun / melee / gunblade -------------------------------------------

        local function PatchShooting(mod, fields)

            Patch(mod, "StartShooting", function(orig)

                return function(self, ...)

                    local restores = {}

                    if IsOn("P4S1T1") then

                        local factor = 1 / (1 + Num("P4S1S4", 85) / 100)

                        restores[#restores + 1] = ScaleInfo(self, fields, factor)

                    end

                    if IsOn("P4S2T4") and type(self) == "table" and type(self.Info) == "table" then

                        local info = self.Info

                        local savedSpam = info.InputSpammingEnabled

                        info.InputSpammingEnabled = { StartShooting = 0, StartReloading = 0 }

                        restores[#restores + 1] = function() info.InputSpammingEnabled = savedSpam end

                    end

                    return CallSafe(function()

                        for _, r in ipairs(restores) do r() end

                    end, orig, self, ...)

                end

            end)

        end

        local function ReloadFields(info, key)

            if type(info) ~= "table" then return {} end

            if info.ReloadType == "Regular" then

                return { key .. "Length", key .. "ActionTimestamp" }

            elseif info.ReloadType == "Segmented" then

                return {

                    key .. "StartLength", key .. "StartActionTimestamp",

                    key .. "SegmentLength", key .. "SegmentActionTimestamp",

                    key .. "FinishLength", key .. "FinishActionTimestamp",

                }

            end

            return {}

        end

        local function PatchGun(gun)

            if not gun then return end

            PatchShooting(gun, { "ShootCooldown", "ShootBurstCooldown", "QuickShotCooldown" })

            Patch(gun, "StartReloading", function(orig)

                return function(self, forceReload, reloadEnum, animationEnum, segmentedCount)

                    if not IsOn("P4S1T2") then

                        return CallSafe(nil, orig, self, forceReload, reloadEnum, animationEnum, segmentedCount)

                    end

                    local boost = math.clamp(Num("P4S1S3", 20), 0, 20)

                    local info = self and self.Info

                    local key = "Reload"

                    if type(info) == "table" and info.HasEmptyReload and type(self.Get) == "function" then

                        local ok, ammo = pcall(self.Get, self, "Ammo")

                        if ok and ammo == 0 then key = "EmptyReload" end

                    end

                    local restore = ScaleInfo(self, ReloadFields(info, key), 1 - boost / 100)

                    return CallSafe(restore, orig, self, forceReload, reloadEnum, animationEnum, segmentedCount)

                end

            end)

            Patch(gun, "_Recoil", function(orig)

                return function(self, mult)

                    if IsOn("P4S1T4") and type(mult) == "number" then

                        local reduced = mult * (1 - Num("P4S1S2", 100) / 100)

