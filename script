        -- ---------- Scythe dash cooldown ---------------------------------------------

        -- Port của ApplyPersistentItemModifiers: giảm Info.DashCooldown của item có dash.

        local DashOriginals = setmetatable({}, { __mode = "k" })

        local function ApplyDash()

            local fighter = GetLocalFighter()

            local items = fighter and rawget(fighter, "Items")

            if type(items) ~= "table" then return end

            local enabled = IsOn("P4S1T5")

            local reduction = math.clamp(Num("P4S1S5", 75), 0, 100) / 100

            for _, item in pairs(items) do

                local info = type(item) == "table" and rawget(item, "Info")

                if type(info) == "table" and type(info.DashCooldown) == "number" then

                    if DashOriginals[info] == nil then DashOriginals[info] = info.DashCooldown end

                    if enabled then

                        info.DashCooldown = DashOriginals[info] * (1 - reduction)

                    else

                        info.DashCooldown = DashOriginals[info]

                    end

                end

            end

