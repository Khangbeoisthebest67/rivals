        -- ---------- Grenade Fuse ------------------------------------------------------

        -- Port của KiciaInputHook + KiciaGrenadeFusePrototype.

        local InputHook = { Installed = false, Restore = nil, Bindings = {} }

        local ThrowableRestore = nil

        local FuseState = { trajectory = nil, explodeOn = "Impact", removeFuse = false }

        local function GetItemById(objectId)

            local fighter = GetLocalFighter()

            for _, item in pairs(fighter and rawget(fighter, "Items") or {}) do

                local data = type(item) == "table" and rawget(item, "Data")

                if type(data) == "table" and rawget(data, "ObjectID") == objectId then

                    return item

                end

            end

            return nil

        end

        local function ComputeImpactTime(tv)

            local lastArgs = rawget(tv, "_last_args") or {}

            local step = lastArgs[4] or 0.05

            local cap = lastArgs[6] or math.huge

            local impact = rawget(tv, "_impact_sphere")

            local segments = rawget(tv, "_segments")

            if not impact or type(segments) ~= "table" then return nil end

            local impactCF = impact.CFrame

            local key

            while true do

                local seg

                key, seg = next(segments, key)

                if key == nil then break end

                if seg.CFrame == impactCF then

                    return math.min(cap, (key - 2) * step)

                end

            end

            return nil

        end

        local function HandleFuse(packet)

            local pt = packet.type

            local isStart = pt == "StartShooting" or pt == "StartAiming"

            local isFinish = pt == "FinishShooting" or pt == "FinishAiming"

            if not (isStart or isFinish) then return end

            local item = GetItemById(packet.objectId)

            if not item then return end

            local info = rawget(item, "Info")

            if type(info) ~= "table" or not rawget(info, "CanCook") then return end

            if isStart then

                FuseState.trajectory = rawget(item, "_trajectory_visual")

                if FuseState.removeFuse then rawset(item, "_cook_detonate_delay", nil) end

                return

            end

            if FuseState.explodeOn == "Throw" then

                packet.args["\3"] = 0

            else

                local tv = FuseState.trajectory

                packet.args["\3"] = tv and ComputeImpactTime(tv) or nil

            end

            FuseState.trajectory = nil

        end

        local function Dispatch(packet)

            for _, binding in ipairs(InputHook.Bindings) do

                if binding.enabled and binding.handler then

                    binding.handler(packet)

                    if packet.block then break end

                end

            end

        end

        local function InstallInputHook()

            if InputHook.Installed then return true end

            if type(setrawmetatable) ~= "function" or type(debug.getupvalues) ~= "function"

                or type(debug.setupvalue) ~= "function" or type(clonefunction) ~= "function" then

                warn("[WeaponMods] Executor thiếu hàm debug/clonefunction - Grenade Fuse không chạy")

                return false

            end

            local clientItem = FindModule({ "Modules", "ClientReplicatedClasses", "ClientFighter", "ClientItem" })

            local remotes = ReplicatedStorage:FindFirstChild("Remotes")

            local replication = remotes and remotes:FindFirstChild("Replication")

            local fighterRemotes = replication and replication:FindFirstChild("Fighter")

            local useItem = fighterRemotes and fighterRemotes:FindFirstChild("UseItem")

            local enumLib = ReplicatedStorage:FindFirstChild("Modules")

                and ReplicatedStorage.Modules:FindFirstChild("EnumLibrary")

            local enumMod = enumLib and select(2, pcall(require, enumLib))

            local fromEnum = type(enumMod) == "table" and rawget(enumMod, "_from_enum")

            if type(clientItem) ~= "table" or not useItem or type(fromEnum) ~= "table" then

                return false

            end

            local inputMethod = rawget(clientItem, "Input")

            if type(inputMethod) ~= "function" then return false end

            local nativeFire = clonefunction(Instance.new("RemoteEvent").FireServer)

            local fakeRemote = { UseItem = {} }

            fakeRemote.UseItem.FireServer = function(_, objectId, encodedType, args)

                local packet = {

                    block = false,

                    objectId = objectId,

                    type = rawget(fromEnum, encodedType),

                    args = args,

                }

                Dispatch(packet)

                if packet.block then return end

                return nativeFire(useItem, objectId, encodedType, args, nil)

            end

            local dummy = Color3.new()

            setrawmetatable(dummy, {

                __index = function()

                    return { Replication = { Fighter = fakeRemote } }

                end,

            })

            -- Thay upvalue ReplicatedStorage bằng dummy để chặn đường gửi UseItem.

            local restore

            for index, value in pairs(debug.getupvalues(inputMethod)) do

                if value == ReplicatedStorage then

                    debug.setupvalue(inputMethod, index, dummy)

                    restore = function() debug.setupvalue(inputMethod, index, ReplicatedStorage) end

                    break

                end

